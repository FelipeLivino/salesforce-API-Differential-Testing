# Copie para .env. O .env real nunca é versionado.

# Porta publicada em 127.0.0.1 no computador local.
APP_PORT=3000

# Caminho do banco fora do Docker. Padrão: data/app.db. No container, o Dockerfile define /app/data/app.db.
# DATABASE_PATH=data/app.db

# Chave AES-256-GCM dos segredos: 32 bytes em base64.
# Gere a sua com: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=
